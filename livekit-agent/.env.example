"""ULTRON LiveKit worker config — copy to .env (or put these in ../.env.local).

The worker reads the SAME keys as the web app (load_dotenv(".env.local") is
called first), so if your web app already works, the agent needs nothing new.
"""

# LiveKit Cloud project → https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Same keys as the web app (read from ../.env.local automatically) ──
# GEMINI_API_KEY=      # LLM primary
# GROQ_API_KEY=        # LLM fallback + Whisper STT
# OPENROUTER_API_KEY=  # LLM last resort
# FISH_AUDIO_API_KEY=  # ULTRON's voice in LIVE mode
# FISH_AUDIO_VOICE_ID=
