# ─── ULTRON Agent — API Keys ────────────────────────────────────────────────
# Copy this file to .env.local and fill in your keys. Restart `npm run dev`
# after changing. Never commit .env.local — it is git-ignored.
#
# The LLM chain tries these IN ORDER: Gemini → Groq → OpenRouter.
# Any one is enough; all three gives maximum resilience.

# 1) GEMINI (primary — free tier) → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2) GROQ (fallback 1 — free, extremely fast) → https://console.groq.com/keys
GROQ_API_KEY=

# 3) OPENROUTER (fallback 2 — free models available) → https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── Voice: FISH AUDIO (optional) ───────────────────────────────────────────
# If set, ULTRON speaks with a Fish Audio voice model. If missing/failed,
# ULTRON automatically falls back to the browser's built-in voice.
# Get a key → https://fish.audio → Settings → API Keys
FISH_AUDIO_API_KEY=

# Optional: paste a voice model ID from https://fish.audio (Discover page)
# to choose exactly how ULTRON sounds. Leave empty for Fish Audio default.
FISH_AUDIO_VOICE_ID=

# ----------------------------------------
# LIVEKIT (optional - realtime voice bridge)
# Free tier -> https://cloud.livekit.io -> create a project -> copy all three.
# When set, the "LIVE" button in ULTRON connects to a LiveKit room for
# server-side STT/TTS (LiveKit Agents). When unset, the button shows
# LIVE UNAVAILABLE and the local Web Speech pipeline keeps working.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
